[Unit]
Description=Vecta leave management (gunicorn)
After=network.target postgresql.service

[Service]
User=vecta
Group=www-data
WorkingDirectory=/srv/vecta/app
EnvironmentFile=/etc/vecta.env
RuntimeDirectory=vecta
ExecStart=/srv/vecta/venv/bin/gunicorn config.wsgi:application --workers 3 --bind unix:/run/vecta/gunicorn.sock --timeout 30 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
