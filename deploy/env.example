# Copy to /etc/vecta.env  (chmod 640, owner root:vecta). One KEY=value per line, no spaces around "=".
# Generate the secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=leave.university.edu.ng
SITE_URL=https://leave.university.edu.ng

# Database (PostgreSQL)
POSTGRES_DB=vecta
POSTGRES_USER=vecta
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost

# Email: required for verification codes and password resets
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=apikey-or-username
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Vecta <no-reply@university.edu.ng>

# Who may create their own account / sign up through Google or Microsoft (comma separated, blank = anyone)
ALLOWED_EMAIL_DOMAINS=university.edu.ng
TOKEN_TTL_DAYS=30
ALLOW_SELF_REGISTRATION=1

# Optional sign-in providers (see DEPLOY.md). Leave blank to hide the buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=your-tenant-id-or-domain

# Behind nginx: 1. Set BEHIND_PROXY=0 only if gunicorn is exposed directly.
BEHIND_PROXY=1
NUM_PROXIES=1
